# Copy to `.env` and fill in your own values. Never commit `.env`.

# MongoDB connection string. Must point at a replica set — Prisma uses
# transactions internally, so a standalone `mongod` will fail at runtime.
# Atlas free-tier clusters are replica sets by default; for local Docker run
# `mongod --replSet rs0` and `rs.initiate()` once.
# The database name is the path segment (`/schedulex` below).
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/schedulex?retryWrites=true&w=majority"

# Local replica-set alternative:
# DATABASE_URL="mongodb://localhost:27017/schedulex?replicaSet=rs0"

# Optional — only if FET is not on your PATH
# FET_BINARY_PATH=C:\Program Files\FET\fet-7.8.7\fet-cl.exe
